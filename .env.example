DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=terai_food
POSTGRES_USER=terai
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60
HTTP_PORT=8080

# Customer email: local inbox at http://localhost:8025; see docs/customer-auth.md
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Terai Food <noreply@teraifood.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Payment Configuration (Stripe Test Mode or Demo)
# Set ORDER_PAYMENT_MODE=demo for local testing without Stripe credentials (requires DEBUG=True)
# Or set ORDER_PAYMENT_MODE=stripe and provide test keys below:
ORDER_PAYMENT_MODE=stripe
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
ORDER_PUBLIC_ORIGIN=http://127.0.0.1:8000
