[Unit]
Description=Terai Foods Shopify draft synchronization worker
After=network.target postgresql.service redis-server.service

[Service]
User=teraifoods
Group=teraifoods
WorkingDirectory=/opt/teraifoods
EnvironmentFile=/opt/teraifoods/.env.server
ExecStart=/opt/teraifoods/.venv/bin/celery -A config worker --queues=shopify --hostname=shopify@%%h --loglevel=WARNING --concurrency=1 --max-tasks-per-child=100
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryHigh=192M
MemoryMax=320M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
