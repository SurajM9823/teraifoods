DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-private-secret
DJANGO_ALLOWED_HOSTS=store.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://store.example.com
DJANGO_HSTS_SECONDS=0
NGINX_HOST=store.example.com
POSTGRES_DB=terai_food
POSTGRES_USER=terai
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
DB_CONN_MAX_AGE=60
WEB_THREADS=8
WEB_CONNECTION_LIMIT=200
APP_TAG=production

# Customer authentication (real SMTP required)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CMS uploads use server media/cms/banners/YYYY/MM/. No cloud credentials required.
